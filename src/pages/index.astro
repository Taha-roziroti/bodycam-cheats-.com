---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import ContentFigures from '../components/content/ContentFigures.astro';
import { Button } from '@/components/starwind/button';
import { resolvePageSeo } from '../config/seo';
import { loadContentPage } from '../utils/loadContentPage';
import { jsonLdForContentPage } from '../utils/contentPageJsonLd';
import { defaultWebpSrc, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { BODYCAM_HERO } from '../data/placeholders';

const seo = resolvePageSeo('/');
const entry = await loadContentPage('home');
const data = entry.data;
const { Content: HomeContent } = await render(entry);
const jsonLd = jsonLdForContentPage({
  route: data.route,
  seoTitle: seo.title,
  metaDescription: seo.description,
  schemaTypes: data.schemaTypes,
});
const lcpPreload = defaultWebpSrc(BODYCAM_HERO, HERO_IMAGE_WIDTHS);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={jsonLd}
  ogImage={data.ogImage}
  ogImageAlt={data.heroImage?.alt ?? data.seoTitle}
  logoAlt="Bodycam Cheats – logo"
>
  <link slot="head" rel="preload" as="image" href={lcpPreload} type="image/webp" fetchpriority="high" />
  <HomeLanding />
  <section class="border-t border-border bg-muted/10 py-12 md:py-16" aria-label="Bodycam cheats overview">
    <div class="content-markdown mx-auto max-w-3xl px-5">
      <HomeContent />
      <ContentFigures figures={data.figures} />
      {
        data.endCtaLabel ? (
          <div class="not-prose mt-10">
            <Button
              as="a"
              href={data.endCtaHref ?? '/go/bodycam/'}
              variant="primary"
              size="lg"
              class="w-full max-w-full rounded-xl text-center whitespace-normal sm:w-auto sm:whitespace-nowrap"
            >
              {data.endCtaLabel}
            </Button>
          </div>
        ) : null
      }
    </div>
  </section>
</BaseLayout>

<style is:global>
  .content-markdown :where(h1) {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  .content-markdown :where(h2) {
    font-family: var(--font-heading, inherit);
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 7rem;
    color: var(--foreground);
  }
  .content-markdown :where(p, ul, ol) {
    color: var(--muted-foreground);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .content-markdown :where(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .content-markdown :where(a:not([data-slot='button'])) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
