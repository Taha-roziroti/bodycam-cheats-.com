---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support – Borderlands 3 Cheats logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Support', path: '/support/' },
      ]}
    />
  </div>
  <ContactSupportSection titleId="support-page-title" showTicketTips />
  <section class="mx-auto max-w-3xl px-5 pb-12 text-sm leading-relaxed text-muted-foreground">
    <p class="text-lg font-semibold text-foreground">Support: plans and setup proof</p>
    <p class="mt-3">
      Before you open a ticket, confirm the listed offers match your order: Borderlands 3 cheats at $35 monthly or $150 lifetime, plus an optional $50 lifetime Cloud DMA license on a separate checkout.
    </p>
    <p class="mt-3">
      Common support answers live in the <a href="/faq/" class="text-primary underline">pre-purchase FAQ</a> (Windows 10/11, Steam or Official Client, Hyper-V, and license moves). Include your order email, Windows build, and any loader or Hyper-V error text when you contact us.
    </p>
  </section>
</BaseLayout>
