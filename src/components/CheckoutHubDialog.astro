---
import CheckoutProductPicker from './product/CheckoutProductPicker.astro';
import Icon from './icons/Icon.astro';
---

<dialog
  id="checkout-hub"
  class="checkout-hub-dialog w-[min(100%,28rem)] max-w-[calc(100vw-2rem)] rounded-2xl border border-border bg-card p-0 text-foreground shadow-2xl backdrop:bg-black/70 open:flex open:max-h-[min(92vh,40rem)] open:flex-col"
  aria-labelledby="checkout-hub-title"
  data-checkout-hub-dialog
>
  <div class="flex items-start justify-between gap-3 border-b border-border bg-muted/30 px-5 py-4">
    <div class="min-w-0 text-left">
      <p class="text-sm font-medium text-muted-foreground">Checkout</p>
      <h2 id="checkout-hub-title" class="text-lg font-semibold tracking-tight">Choose a product</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Bodycam cheats, Cloud DMA, or HWID Spoofer—then continue to secure checkout.
      </p>
    </div>
    <button
      type="button"
      class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border bg-background text-muted-foreground transition-colors hover:text-foreground"
      data-checkout-hub-close
      aria-label="Close"
    >
      <Icon name="x" size={18} />
    </button>
  </div>
  <div class="min-h-0 flex-1 overflow-y-auto p-5">
    <CheckoutProductPicker class="lg:static lg:top-auto" />
  </div>
</dialog>
