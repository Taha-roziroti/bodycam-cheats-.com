---
import '../styles/support-section.css';
import { t } from '../i18n';
import { CHECKOUT_HUB_PATH } from '../config/checkout';
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import { Button } from '@/components/starwind/button';
import SectionHeader from './SectionHeader.astro';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  titleId?: string;
  showTicketTips?: boolean;
  class?: string;
}

const { titleId = 'support-title', showTicketTips = false, class: className } = Astro.props;
const c = t.support;
---

<section
  id="support"
  class:list={['support-section border-y border-border bg-muted/20 py-16 md:py-24', className]}
  aria-labelledby={titleId}
>
  <div class="support-section__inner mx-auto max-w-6xl px-5">
    <SectionHeader
      class="support-section__header"
      eyebrow={c.eyebrow}
      title={c.title}
      desc={c.subtitle}
      titleId={titleId}
      wide
      centered
      readableTitle
    />

    <ul class="support-section__cards">
      {
        c.channels.map((channel) => (
          <li>
            <Card class="support-section__card group flex h-full flex-col transition-shadow hover:shadow-md">
              <CardHeader class="space-y-4">
                <div class="flex size-10 items-center justify-center rounded-lg bg-primary/10">
                  <Icon name={channel.icon as IconName} size={22} class="support-section__icon" />
                </div>
                <CardTitle class="text-base font-semibold normal-case leading-snug">{channel.title}</CardTitle>
              </CardHeader>
              <CardContent class="flex-1">
                <p class="text-sm leading-relaxed text-muted-foreground">{channel.desc}</p>
              </CardContent>
              <CardFooter>
                <Button
                  as="a"
                  href={channel.href}
                  variant="outline"
                  size="sm"
                  title={channel.linkLabel}
                  class="support-section__cta"
                  {...(channel.href === CHECKOUT_HUB_PATH ? { 'data-checkout-hub': '' } : {})}
                >
                  {channel.linkLabel}
                  <Icon name="arrowRight" size={17} />
                </Button>
              </CardFooter>
            </Card>
          </li>
        ))
      }
    </ul>

    {
      showTicketTips && (
        <div class="support-section__tips">
          <h2 class="support-section__tips-title">{c.ticketTitle}</h2>
          <ul class="support-section__tips-list">
            {c.ticketItems.map((item) => (
              <li class="support-section__tips-item">
                <p class="support-section__tips-item-title">{item.title}</p>
                <p class="support-section__tips-item-desc">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
