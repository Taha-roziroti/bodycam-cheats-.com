---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';

interface Props {
  logoAlt?: string;
}

const { logoAlt } = Astro.props;

const resourceLinks = [
  { href: '/pricing/', label: 'Compare monthly and lifetime prices', ariaLabel: 'Pricing' },
  { href: '/cloud-dma/', label: 'Review the $50 lifetime DMA license', ariaLabel: 'Cloud DMA' },
  { href: '/guides/cloud-dma-setup/', label: 'Walk through Hyper-V activation', ariaLabel: 'Setup guide' },
  { href: '/guides/borderlands-3-cheat-system-requirements/', label: 'Check Windows and RAM specs', ariaLabel: 'Requirements' },
  { href: '/support/', label: 'Open checkout and delivery help', ariaLabel: 'Support' },
];

const legalLinks = [
  { href: '/about/', label: 'Who publishes this site' },
  { href: '/privacy/', label: 'Analytics and cookie notice' },
  { href: '/terms/', label: 'Purchase and refund rules' },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-semibold" aria-label={t.ui.homeAria}>
          <img src="/logo.svg" alt={logoAlt ?? ''} width="32" height="32" class="rounded-md" />
          <span aria-hidden="true">Borderlands 3 <span class="text-muted-foreground">Cheats</span></span>
          <span class="sr-only"> site footer</span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-sm font-medium text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-sm font-medium text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground" aria-label={link.ariaLabel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-sm font-medium text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
