---
import type { BreadcrumbItem } from '../utils/schema';
import {
  Breadcrumb,
  BreadcrumbItem as CrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;

/** Hide on homepage (single “Home” crumb only). */
const showTrail = items.length > 1;
---

{
  showTrail ? (
    <Breadcrumb class:list={['site-breadcrumbs', className]} aria-label="Breadcrumb">
      <BreadcrumbList class="gap-1.5 text-sm sm:gap-2">
        {items.map((item, index) => {
          const isLast = index === items.length - 1;
          return (
            <>
              <CrumbItem>
                {isLast ? (
                  <BreadcrumbPage class="font-medium text-primary">{item.name}</BreadcrumbPage>
                ) : (
                  <BreadcrumbLink
                    href={item.path}
                    class="text-muted-foreground transition-colors hover:text-foreground hover:underline hover:underline-offset-4"
                  >
                    {item.name}
                  </BreadcrumbLink>
                )}
              </CrumbItem>
              {!isLast && <BreadcrumbSeparator class="text-muted-foreground/45 [&>svg]:size-3.5" />}
            </>
          );
        })}
      </BreadcrumbList>
    </Breadcrumb>
  ) : null
}
