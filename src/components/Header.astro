---
import { t } from '../i18n';
import { checkoutPath } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';

import type { IconName } from './icons/types';

const navIcons: Record<string, IconName> = {
  Pricing: 'navProducts',
  'Cloud DMA': 'reqCpu',
  'Setup guide': 'navBlog',
  Requirements: 'reqSettings',
  Support: 'navSupport',
};

const purchaseUrl = checkoutPath('borderlands3');
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto relative flex h-14 w-full max-w-6xl items-center justify-between gap-3 rounded-xl border border-border bg-card/95 px-4 text-foreground shadow-sm sm:px-5 lg:h-16"
    >
    <a href="/" class="inline-flex min-w-0 items-center gap-2 font-[family-name:var(--font-heading)] text-base font-semibold sm:text-lg" aria-label={t.ui.homeAria}>
      <span class="size-2 shrink-0 rounded-full bg-primary" aria-hidden="true" title="Loot rarity accent"></span>
      <span class="truncate" aria-hidden="true">Borderlands 3 <span class="text-muted-foreground">Cheats</span></span>
    </a>

    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIcons[link.label] ?? 'navFeatures'} size={16} />
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-3 sm:flex">
        <Button as="a" href={purchaseUrl} variant="primary" size="md" class="hidden rounded-lg border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.14)] lg:inline-flex" aria-label={t.ui.checkoutAria}>
          {t.ui.browseCheats}
        </Button>
        <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex" />
      </div>

      <Sheet class="lg:hidden">
        <SheetTrigger
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted lg:hidden"
          aria-label={t.ui.menuOpen}
        >
          <Icon name="menu" size={20} />
        </SheetTrigger>
        <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
          <SheetHeader>
            <SheetTitle>{t.site.name}</SheetTitle>
          </SheetHeader>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={link.href}
                class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIcons[link.label] ?? 'navFeatures'} size={16} />
                {link.label}
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
            {t.ui.browseCheatsMobile}
          </Button>
          <div class="flex justify-center pt-1">
            <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
          </div>
        </SheetContent>
      </Sheet>
    </div>
    </div>
  </div>
</header>
