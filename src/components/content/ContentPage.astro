---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CheckoutProductPicker from '../product/CheckoutProductPicker.astro';
import CheckoutPanel from '../product/CheckoutPanel.astro';
import {
  checkoutHrefForProduct,
  checkoutPanelHeading,
  lockedCheckoutProduct,
  type CheckoutProductId,
} from '../../utils/checkoutContext';
import ContentFigures from './ContentFigures.astro';
import ContentHeroImage from './ContentHeroImage.astro';
import { defaultWebpSrc, HERO_IMAGE_WIDTHS, isRasterImageSrc } from '../../utils/responsiveImage';
import {
  breadcrumbsForRoute,
  defaultEndCtaHref,
  jsonLdForContentPage,
} from '../../utils/contentPageJsonLd';
import { Button } from '@/components/starwind/button';
import { loadContentPage } from '../../utils/loadContentPage';
import { resolvePageSeo } from '../../config/seo';
import SiteFaqSection from '../SiteFaqSection.astro';
import { faqFilterTopicsForItems, getContentPageFaqs } from '../../data/faq';
import '@/styles/content-markdown.css';
import '@/styles/content-page-layout.css';

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = await loadContentPage(id);

const data = entry.data;
const { Content: FullContent } = await render(entry);
const seoMeta = resolvePageSeo(data.route);

const breadcrumbs = breadcrumbsForRoute(data.route);
const jsonLd = jsonLdForContentPage({
  route: data.route,
  seoTitle: seoMeta.title,
  metaDescription: seoMeta.description,
  schemaTypes: data.schemaTypes,
  articlePublished: data.articlePublished,
});
const ctaHref = data.endCtaHref ?? defaultEndCtaHref(data.route, data.checkout);
const lockedProduct = lockedCheckoutProduct(data.route);
const sidebarDefaultProduct: CheckoutProductId =
  lockedProduct ??
  (data.checkout === 'cloud-dma'
    ? 'cloud-dma'
    : data.checkout === 'hwid-spoofer'
      ? 'hwid-spoofer'
      : 'main-product');

const asideProduct: CheckoutProductId | null =
  lockedProduct ??
  (data.checkout === 'cloud-dma'
    ? 'cloud-dma'
    : data.checkout === 'hwid-spoofer'
      ? 'hwid-spoofer'
      : data.checkout
        ? 'main-product'
        : null);
const useTwoColumn = Boolean(asideProduct);
const checkoutDefaultProduct = asideProduct ?? sidebarDefaultProduct;
const ogType = data.layout === 'article' ? 'article' : 'website';
const lcpPreload =
  data.route === '/' && data.heroImage && isRasterImageSrc(data.heroImage.src)
    ? defaultWebpSrc(data.heroImage.src, HERO_IMAGE_WIDTHS)
    : null;

const logoAltByRoute: Record<string, string> = {
  '/': 'Bodycam Cheats – logo',
  '/bodycam-cheats-price/': 'Bodycam pricing – logo',
  '/bodycam-aimbot/': 'Bodycam aimbot – logo',
  '/bodycam-esp/': 'Bodycam ESP – logo',
  '/bodycam-requirements/': 'Bodycam requirements – logo',
  '/cloud-dma-for-bodycam/': 'Cloud DMA for Bodycam – logo',
  '/guides/cloud-dma-setup/': 'Cloud DMA setup – logo',
};
const logoAlt = logoAltByRoute[data.route];
const pageFaqs = getContentPageFaqs(data.route);
const pageFaqTopics = pageFaqs ? faqFilterTopicsForItems(pageFaqs) : [];
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  jsonLd={jsonLd}
  ogType={ogType}
  ogImage={data.ogImage}
  ogImageAlt={data.heroImage?.alt ?? data.seoTitle}
  articlePublishedTime={data.articlePublished}
  logoAlt={logoAlt}
>
  {lcpPreload ? (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={lcpPreload}
      type="image/webp"
      fetchpriority="high"
      media="(min-width: 1024px)"
    />
  ) : null}
  <section class="border-b border-border bg-muted/20 py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
      <div
        class:list={[
          'content-page__grid gap-10',
          useTwoColumn && 'lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)]',
          !useTwoColumn && 'content-page__grid--single',
        ]}
      >
        <div class="content-page__main">
          <div class:list={['content-markdown', data.heroImage && data.route === '/' && 'product-hero-after-h1']}>
            {data.heroImage && data.route === '/' ? (
              <ContentHeroImage
                src={data.heroImage.src}
                alt={data.heroImage.alt}
                priority={true}
                class="hero-after-title"
              />
            ) : null}
            {FullContent ? <FullContent /> : null}
            {data.heroImage && data.route !== '/' ? (
              <ContentHeroImage
                src={data.heroImage.src}
                alt={data.heroImage.alt}
                priority={false}
                class="mt-8"
              />
            ) : null}
            <ContentFigures figures={data.figures} />
          </div>
          {
            useTwoColumn ? (
              <div class="not-prose mt-8 lg:hidden">
                {
                  lockedProduct ? (
                    <CheckoutPanel
                      productSlug={lockedProduct}
                      buyUrl={checkoutHrefForProduct(lockedProduct)}
                      heading={checkoutPanelHeading(lockedProduct)}
                    />
                  ) : (
                    <CheckoutProductPicker defaultProduct={checkoutDefaultProduct} />
                  )
                }
              </div>
            ) : null
          }
        </div>
        {
          useTwoColumn ? (
            <aside class="content-page__aside hidden lg:block" aria-label="Checkout and plan options">
              {
                lockedProduct ? (
                  <CheckoutPanel
                    productSlug={lockedProduct}
                    buyUrl={checkoutHrefForProduct(lockedProduct)}
                    heading={checkoutPanelHeading(lockedProduct)}
                  />
                ) : (
                  <CheckoutProductPicker defaultProduct={checkoutDefaultProduct} />
                )
              }
            </aside>
          ) : null
        }
      </div>
    </div>
  </section>

  {
    pageFaqs && pageFaqs.length > 0 ? (
      <SiteFaqSection
        id="page-faq"
        titleId="page-faq-title"
        titleAs="h2"
        items={pageFaqs}
        showFilters={pageFaqTopics.length > 1}
        filterTopics={pageFaqTopics}
        class="border-t border-border"
      />
    ) : null
  }

  {
    data.endCtaLabel ? (
      <div class="border-t border-border bg-muted/20 py-10 md:py-12">
        <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-5">
          <Button
            as="a"
            href={ctaHref}
            variant="primary"
            size="lg"
            class="w-full max-w-full rounded-xl text-center whitespace-normal sm:w-auto sm:whitespace-nowrap"
          >
            {data.endCtaLabel}
          </Button>
        </div>
      </div>
    ) : null
  }
</BaseLayout>
