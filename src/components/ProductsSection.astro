---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { landingProducts } from '../data/landing';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from '@/components/starwind/carousel';

const s = t.products;

function cardIcon(product: (typeof landingProducts)[number]) {
  return product.icon;
}

function cardLabel(product: (typeof landingProducts)[number]) {
  return product.label;
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={s.eyebrow}
      title={s.title}
      desc={s.subtitle}
      titleId="products-title"
      titleAs="h2"
      wide
      flush
    />

    <div class="products-carousel" data-products-carousel>
      <Carousel
        autoInit
        opts={{ align: 'start', containScroll: 'trimSnaps', dragFree: false }}
        class="products-carousel__root"
      >
        <div class="products-carousel__stage">
          <CarouselPrevious class="products-carousel__arrow products-carousel__arrow--prev" hidden />
          <CarouselNext class="products-carousel__arrow products-carousel__arrow--next is-visible" />
          <div class="products-carousel__viewport">
            <CarouselContent class="products-carousel__track">
              {
                landingProducts.map((product) => (
                  <CarouselItem class="products-carousel__slide">
                    <CatalogCard
                      class="catalog-card--carousel"
                      label={cardLabel(product)}
                      title={product.title}
                      href={product.href}
                      buyUrl={product.buyUrl}
                      features={product.features}
                      more={product.more}
                      icon={cardIcon(product)}
                      badge={product.badge}
                      variant={product.variant}
                      buyLabel={product.buyLabel ?? 'Buy now'}
                      viewLabel={product.viewLabel ?? `About ${product.title}`}
                      maxFeatures={5}
                    />
                  </CarouselItem>
                ))
              }
            </CarouselContent>
          </div>
        </div>
      </Carousel>
    </div>
  </div>
</section>

<script>
  const bootProductsCarousel = () =>
    import('../scripts/products-carousel.ts').then((m) => m.setupProductsCarousel());
  if (typeof requestIdleCallback === 'function') {
    requestIdleCallback(() => bootProductsCarousel(), { timeout: 2500 });
  } else {
    setTimeout(() => bootProductsCarousel(), 150);
  }
</script>
